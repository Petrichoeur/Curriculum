# ---- Obligatoire ----
# Clé API OpenRouter. Ne JAMAIS la commiter : elle vit uniquement dans les
# variables d'environnement du projet Vercel.
OPENROUTER_API_KEY=

# ---- Recommandé ----
# Origine autorisée à appeler /api/chat. Sans cette variable, l'endpoint
# reste ouvert (le rate-limiting s'applique quand même). Exemple :
#   https://curriculum.vercel.app
ALLOWED_ORIGIN=

# ---- Provider (valeurs par défaut) ----
# `openrouter/free` fait router OpenRouter vers un modèle gratuit de son
# catalogue. Surchargeable pour payer un modèle précis, par exemple :
#   anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=openrouter/free

# Base URL : à ne changer que pour pointer un relais compatible OpenAI.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# URL du site, utilisée pour l'en-tête d'attribution HTTP-Referer.
SITE_URL=

# ---- Rate limiting (best-effort, en mémoire par instance) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000