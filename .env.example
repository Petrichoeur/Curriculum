# ---- Obligatoire ----
# Clé API Google Gemini. Ne JAMAIS la commiter : elle vit uniquement
# dans les variables d'environnement du projet Vercel.
GEMINI_API_KEY=

# ---- Recommandé ----
# Origine autorisée à appeler /api/chat. Sans cette variable, l'endpoint
# reste ouvert (le rate-limiting s'applique quand même). Exemple :
#   https://curriculum.vercel.app
ALLOWED_ORIGIN=

# Modèle Gemini utilisé par le proxy.
GEMINI_MODEL=gemma-3-27b-it

# ---- Rate limiting (best-effort, en mémoire par instance) ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000